          "noValue": "UNKNOWN",
          "mappings": []
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"event_ipsec_site_sa_(rx|tx)_bytes\",event_id=~\"$event_id\",hub_id=~\"$hub_id\",site_id=~\"$site_id\"}",
          "instant": false,
          "range": true
