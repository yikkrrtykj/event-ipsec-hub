          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event_ipsec_site_ike_state{event_id=~\"$event_id\",hub_id=~\"$hub_id\",site_id=~\"$site_id\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
