      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
