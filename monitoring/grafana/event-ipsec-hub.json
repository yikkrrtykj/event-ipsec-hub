{
  "title": "Event IPsec Hub",
  "uid": "event-ipsec-hub",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "event_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(event_ipsec_daemon_state, event_id)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "hub_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(event_ipsec_daemon_state, hub_id)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "site_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(event_ipsec_site_ike_state, site_id)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "采集新鲜度",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "UNKNOWN",
          "mappings": []
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "event_ipsec_snapshot_age_seconds",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "采集原因",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN",
          "mappings": []
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "event_ipsec_observation_reason",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Hub daemon",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "-1": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event_ipsec_daemon_state{event_id=~\"$event_id\",hub_id=~\"$hub_id\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "IKE",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "-1": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
